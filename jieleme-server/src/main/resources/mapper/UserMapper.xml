<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jieleme.module.user.mapper.UserMapper">
    
    <resultMap id="BaseResultMap" type="com.jieleme.module.user.entity.User">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="phone" property="phone" jdbcType="VARCHAR"/>
        <result column="nickname" property="nickname" jdbcType="VARCHAR"/>
        <result column="avatar_url" property="avatarUrl" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="TINYINT"/>
        <result column="created_at" property="createdAt" jdbcType="TIMESTAMP"/>
        <result column="updated_at" property="updatedAt" jdbcType="TIMESTAMP"/>
        <result column="last_login_at" property="lastLoginAt" jdbcType="TIMESTAMP"/>
    </resultMap>
    
    <sql id="Base_Column_List">
        id, phone, nickname, avatar_url, status, created_at, updated_at, last_login_at
    </sql>
    
    <select id="selectByPhone" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_user
        WHERE phone = #{phone}
        LIMIT 1
    </select>
    
    <select id="selectById" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_user
        WHERE id = #{id}
        LIMIT 1
    </select>
    
    <insert id="insert" parameterType="com.jieleme.module.user.entity.User" 
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO t_user (
            phone,
            nickname,
            avatar_url,
            status,
            created_at,
            updated_at,
            last_login_at
        ) VALUES (
            #{phone},
            #{nickname},
            #{avatarUrl},
            #{status},
            #{createdAt},
            #{updatedAt},
            #{lastLoginAt}
        )
    </insert>
    
    <update id="updateLastLogin">
        UPDATE t_user
        SET last_login_at = #{lastLoginAt}
        WHERE id = #{id}
    </update>
    
    <update id="update" parameterType="com.jieleme.module.user.entity.User">
        UPDATE t_user
        <set>
            <if test="nickname != null">nickname = #{nickname},</if>
            <if test="avatarUrl != null">avatar_url = #{avatarUrl},</if>
            <if test="status != null">status = #{status},</if>
            updated_at = #{updatedAt}
        </set>
        WHERE id = #{id}
    </update>
    
</mapper>
